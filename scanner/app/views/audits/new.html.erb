<% if @error.present? %>
  <p class="error"><%= @error %></p>
<% end %>

<form class="form-row" action="/audits" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input id="url" class="url-input" name="audit[url]" value="<%= @url %>" placeholder="https://example.com">
  <button class="check-btn">Перевірити</button>
</form>

<details class="hint">
  <summary>Адреси навчального стенду</summary>
  <p>Сканер бачить макети по імені в Docker. В браузері вони як localhost:8222 і localhost:8223.</p>
  <button onclick="document.getElementById('url').value='http://vulnerable_target:8222'">Вразливий: http://vulnerable_target:8222</button>
  <button onclick="document.getElementById('url').value='http://secure_target:8223'">Захищений: http://secure_target:8223</button>
</details>

<% if @results.present? %>
  <% problems = problem_results(@results) %>
  <% oks = ok_results(@results) %>

  <div class="totals">
    <div class="total problem"><b><%= problems_caption(problems.size) %></b></div>
    <div class="total ok"><b><%= oks.size %> гаразд</b></div>
  </div>

  <% if problems.any? %>
    <div class="copy-row">
      <button class="check-btn" type="button" onclick="copyText('all-tasks', this)">Скопіювати всі завдання</button>
      <button class="small-btn" type="button" onclick="copyText('all-prompts', this)">Скопіювати всі промпти</button>
    </div>
    <pre id="all-tasks" class="copy-source"><%= bundled_report(problems, :remediation_agency) %></pre>
    <pre id="all-prompts" class="copy-source"><%= bundled_report(problems, :remediation_ai_prompt) %></pre>
  <% end %>

  <% problems.each do |result| %>
    <details class="result <%= status_color(result.status) %>">
      <summary>
        <span class="badge"><%= status_label(result.status) %></span>
        <b><%= result.title %></b>
        <span class="category"><%= result.category %></span>
      </summary>
      <div class="detail">
        <p><b>Що це означає</b></p>
        <p><%= result.business_risk %></p>
        <p><b>Для фахівця</b></p>
        <pre class="pre-box"><%= result.technical_lang %></pre>
        <div class="cols">
          <div class="col">
            <p><b>ТЗ для підрядника</b></p>
            <pre class="pre-box"><%= result.remediation_agency %></pre>
          </div>
          <div class="col">
            <p><b>Промпт для ШІ</b></p>
            <pre class="pre-box"><%= result.remediation_ai_prompt %></pre>
          </div>
        </div>
      </div>
    </details>
  <% end %>

  <% if oks.any? %>
    <details class="ok-group">
      <summary>Гаразд (<%= oks.size %>)</summary>
      <% oks.each do |result| %>
        <details class="result green">
          <summary>
            <span class="badge"><%= status_label(result.status) %></span>
            <b><%= result.title %></b>
            <span class="category"><%= result.category %></span>
          </summary>
          <div class="detail">
            <p><%= result.business_risk %></p>
            <pre class="pre-box"><%= result.technical_lang %></pre>
          </div>
        </details>
      <% end %>
    </details>
  <% end %>
<% end %>
